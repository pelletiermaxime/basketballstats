    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.65",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vercel": "^65.2.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
