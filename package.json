{
  "name": "basketballstats",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names 'vite,convex' --prefix-colors 'cyan,yellow' 'vp run dev:vite' 'vp run dev:convex'",
    "dev:vite": "vp dev",
    "dev:convex": "convex dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "deploy": "vercel --prod",
    "prepare": "vp config --no-agent",
    "test:integration": "vp test run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@convex-dev/react-query": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.48",
    "convex": "^1.48.0",
    "lucide-react": "^1.61.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/typography": "^0.5.20",
